<?xml version="1.0" encoding="UTF-8" ?>

<WaterTile>
        <!-- Define the basic data here, maybe a texture since most tiles will just have one texture -->
    <Data id="waterTileData" name="water tile" texture="../some/path/to/a/texture.png" />
        <!-- Tile specific data here, such as AnimationFrames.
         Has 'Frame' elements which point to the resources for that frame -->
    <AnimationFrames id="animationFrames" count="3">
        <Frame id="F-1" texture="water0" />
        <Frame id="F-2" texture="water1" />
        <Frame id="F-3" texture="water2" />
    </AnimationFrames>
</WaterTile>