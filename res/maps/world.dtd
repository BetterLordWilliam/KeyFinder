<!ELEMENT Map (Data, Tiles, Objects, Entities)>

<!ELEMENT Data EMPTY>
<!ATTLIST Data id ID #REQUIRED>
<!ATTLIST Data name CDATA #REQUIRED>
<!ATTLIST Data xdim CDATA #REQUIRED>
<!ATTLIST Data ydim CDATA #REQUIRED>
<!ATTLIST Data description CDATA #REQUIRED>

<!ELEMENT Tiles (#PCDATA)>
<!ATTLIST Tiles id ID #REQUIRED>

<!ELEMENT Objects (#PCDATA)>
<!ATTLIST Objects id ID #REQUIRED>

<!ELEMENT Entities (#PCDATA)>
<!ATTLIST Entities id ID #REQUIRED>